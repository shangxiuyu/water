#!/usr/bin/env python3
"""Water CLI —— Water Skill 的统一执行引擎（list / login / fetch / install-skill）。"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = ROOT / "registry.json"


def _default_redact(text: str) -> str:
    """内置基础脱敏，防止意外输出 Token/密钥。"""
    text = re.sub(r"(sk-[A-Za-z0-9_-]{16,})", "[REDACTED_KEY]", text)
    text = re.sub(r"(gh[pou]_[A-Za-z0-9]{16,})", "[REDACTED_TOKEN]", text)
    return text


def load_registry() -> dict:
    return json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))


def load_script(cid: str):
    scripts_dir = str(ROOT / "scripts")
    if scripts_dir not in sys.path:
        sys.path.insert(0, scripts_dir)
    path = ROOT / "scripts" / f"{cid}.py"
    if not path.is_file():
        return None
    spec = importlib.util.spec_from_file_location(f"water_script_{cid}", str(path))
    if not spec or not spec.loader:
        return None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def cmd_list(_args) -> int:
    reg = load_registry()
    print("Water Skill 支持平台：\n")
    for item in reg.get("connectors", []):
        status = item.get("status", "planned")
        badge = "✅ ready" if status == "ready" else "🚧 planned"
        print(f"  {item['id']:<10} [{badge}]  {item['name']}")
        print(f"             读取: {', '.join(item.get('reads', []))}")
        print(f"             禁碰: {', '.join(item.get('never_reads', []))}")
        if status == "ready":
            mod = load_script(item["id"])
            if mod and callable(getattr(mod, "discover", None)):
                info = mod.discover()
                print(f"             本机: {info.get('detail', '')}")
        print()
    return 0


def cmd_login(args) -> int:
    mod = load_script(args.source)
    if not mod:
        print(f"❌ 未找到已就绪的平台 `{args.source}`（运行 `water list` 查看可用平台）。", file=sys.stderr)
        return 1
    login_fn = getattr(mod, "login_qr", None)
    if not callable(login_fn):
        print(f"❌ `{args.source}` 暂不支持扫码登录。", file=sys.stderr)
        return 1
    return 0 if login_fn(timeout=args.timeout) else 1


def cmd_fetch(args) -> int:
    cid = args.source
    mod = load_script(cid)
    if not mod:
        print(f"❌ 平台 `{cid}` 尚未就绪（运行 `water list` 查看可用平台）。", file=sys.stderr)
        return 1

    if callable(getattr(mod, "discover", None)):
        info = mod.discover()
        if not info.get("available"):
            if args.no_login:
                print(f"❌ `{cid}` 未登录：{info.get('detail', '')}", file=sys.stderr)
                return 1
            login_fn = getattr(mod, "login_qr", None)
            if not callable(login_fn) or not login_fn(timeout=args.timeout):
                return 1

    helpers = {"redact_secrets": _default_redact}
    md, cnt, _pids = mod.extract(args.days, args.limit, helpers)
    if cnt == 0 or not md.strip():
        print(f"⚠️ `{cid}` 未拉取到有效内容。", file=sys.stderr)
        return 1

    print(md)
    return 0


def cmd_install_skill(_args) -> int:
    home = Path.home()
    skill_targets = [
        home / ".claude/skills",
        home / ".gemini/config/skills",
        home / ".agents/skills",
        home / ".cursor/skills",
        home / ".codex/skills",
    ]
    linked = 0
    for base in skill_targets:
        if base.parent.exists():
            base.mkdir(parents=True, exist_ok=True)
            dest = base / "water"
            if dest.is_symlink() or dest.exists():
                if dest.is_symlink() and dest.resolve() == ROOT.resolve():
                    print(f"  ✓ 已挂载: {dest}")
                    linked += 1
                    continue
                print(f"  ⚠️ 跳过（目标已存在）: {dest}")
                continue
            dest.symlink_to(ROOT)
            print(f"  ✅ 已挂载 Skill: {dest} -> {ROOT}")
            linked += 1

    local_bin = home / ".local/bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    bin_dest = local_bin / "water"
    bin_src = ROOT / "bin/water"
    if bin_dest.is_symlink() and bin_dest.resolve() == bin_src.resolve():
        print(f"  ✓ CLI 已就绪: {bin_dest}")
    elif not bin_dest.exists():
        bin_dest.symlink_to(bin_src)
        print(f"  ✅ 已挂载 CLI: {bin_dest} -> {bin_src}")
    else:
        print(f"  ⚠️ 跳过 CLI（目标已存在）: {bin_dest}")

    if linked == 0:
        print("⚠️ 未检测到常见 Agent Skill 目录，可手动将本目录软链到对应 skills/water。")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="water", description="Water Skill —— Tree 外部上下文灌溉工具")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="查看支持平台及本机登录状态")
    p_list.set_defaults(func=cmd_list)

    p_login = sub.add_parser("login", help="一键扫码登录指定平台（凭证仅存 ~/.water/）")
    p_login.add_argument("source", help="平台 ID，如 jike")
    p_login.add_argument("--timeout", type=int, default=180, help="扫码等待超时秒数")
    p_login.set_defaults(func=cmd_login)

    p_fetch = sub.add_parser("fetch", help="闭环拉取脱敏精华（未登录时自动引导扫码）")
    p_fetch.add_argument("source", help="平台 ID，如 jike")
    p_fetch.add_argument("--days", type=int, default=90, help="回溯天数")
    p_fetch.add_argument("--limit", type=int, default=20, help="最大拉取条数")
    p_fetch.add_argument("--timeout", type=int, default=180, help="扫码等待超时秒数")
    p_fetch.add_argument("--no-login", action="store_true", help="未登录时不自动弹出二维码")
    p_fetch.set_defaults(func=cmd_fetch)

    p_inst = sub.add_parser("install-skill", help="一键挂载 water Skill 与 CLI 到本机各 Agent")
    p_inst.set_defaults(func=cmd_install_skill)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
